{
  "name": "ferrocms",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, headless, Cloudflare-native CMS for JavaScript sites",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build --filter=!./examples/*",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @ferrocms/e2e e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.10.0"
  },
  "pnpm": {
    "overrides": {
      "undici@<6.27.0": ">=6.27.0",
      "ws@<8.21.0": ">=8.21.0",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<8.5.18": ">=8.5.18",
      "vite@<=6.4.2": ">=6.4.3",
      "brace-expansion@<5.0.8": ">=5.0.8",
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  }
}
